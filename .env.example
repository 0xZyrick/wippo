# ── Required for production data (Neon Postgres) ──────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── App URL (used in emails / absolute links later) ───────────────────────
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ── Email OTP in production (optional but needed for real logins) ─────────
# Without this, codes are only returned in development (demoCode).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Wippo <onboarding@your-domain.com>"

# ── Object storage for images/videos (optional; otherwise data-URLs in DB) ─
# Supabase Storage example:
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # server only — never ship to client
# SUPABASE_STORAGE_BUCKET="wippo-media"
