# ── Neon Postgres ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── Neon Managed Better Auth ───────────────────────────────────────────────
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"
# 32+ chars — same role as SESSION_SECRET
NEON_AUTH_COOKIE_SECRET="replace-with-openssl-rand-base64-32"
SESSION_SECRET="replace-with-openssl-rand-base64-32"

# ── Neon Object Storage (S3-compatible) ────────────────────────────────────
AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_..."
AWS_SECRET_ACCESS_KEY="nsk_..."
AWS_REGION="eu-central-1"
S3_BUCKET="media"

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ── PostHog ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
